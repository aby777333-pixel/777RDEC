# Public
# Optional. Left unset, the build uses Netlify's primary site URL (today
# https://777raptor.netlify.app; 777raptor.com once it is the primary domain).
# Set it only to force a different canonical origin.
NEXT_PUBLIC_SITE_URL=

# Search engine ownership tags — only needed if verifying by meta tag rather than DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Supabase — server-side only. The anon key is never used for writes from the browser.
SUPABASE_URL=https://ixpqkvyxqvmllottnvgi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Leave blank to use the no-op console adapter.
RESEND_API_KEY=
DEMO_NOTIFICATION_TO=
# Sender for all mail, on a domain verified in Resend, e.g. 777 Raptor <hello@yourdomain.com>
EMAIL_FROM=
# Where replies to the confirmation emails go (optional)
EMAIL_REPLY_TO=

# Cloudflare Turnstile — forms fall back to honeypot-only when unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# EMIL apps — origin of the Raptor Market API that /api/raptor-market proxies to
# (no trailing slash). Unset = the current market API deploy.
RAPTOR_MARKET_API_ORIGIN=

# Analytics (Plausible). Unset = no-op adapter, no script injected.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Tag Manager container (GTM-XXXXXXX). Unset = no GTM. Loads only after cookie consent.
NEXT_PUBLIC_GTM_ID=
